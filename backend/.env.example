# VOiD Backend Configuration

# App
DEBUG=true

# Database (PostgreSQL with async driver)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/void_db

# Apple Sign In
APPLE_TEAM_ID=your_team_id
APPLE_CLIENT_ID=com.your.app
APPLE_KEY_ID=your_key_id
APPLE_PRIVATE_KEY=your_private_key

# JWT Secret (generate a secure 256-bit key for production)
SECRET_KEY=generate-a-random-256-bit-hex-key
